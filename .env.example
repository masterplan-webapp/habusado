# Supabase (opcional em desenvolvimento: o app usa dados iniciais se estiverem vazias)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave privada service_role usada apenas no servidor pelo painel /admin e cron semanal
SUPABASE_SERVICE_ROLE_KEY=

# Painel de moderacao (/admin). Em producao, obrigatoria para liberar o login.
# Em desenvolvimento local, se ficar vazia, aceita a senha temporaria "admin-dev".
ADMIN_PASSWORD=

# Segredo usado pela Vercel Cron para autenticar GET /api/cron/publish-weekly
CRON_SECRET=

# Google Gemini API (usada pelo assistente H.Aroldo em /haroldo, moderacao e geracao editorial)
GEMINI_API_KEY=

# Resend (envio de e-mails de boas-vindas e avisos de moderacao)
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
